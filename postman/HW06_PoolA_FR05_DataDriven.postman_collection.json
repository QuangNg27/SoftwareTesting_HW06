{
  "info": {
    "_postman_id": "dd112233-4455-6677-8899-aabbccddeeff",
    "name": "HW06 - EShop SUT - Pool A (FR-05 Data-Driven Testing)",
    "description": "Bộ Postman Collection thiết kế theo phương pháp Data-Driven Testing (DDT) cho API FR-05 (GET /api/products). Tự động lặp qua file dữ liệu data_driven_FR05.json / data_driven_FR05.csv để thực thi 40 Test Cases.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// [ANTI-CHEAT] Tự động đính kèm Header X-Student-Id",
          "const studentId = pm.environment.get('student_id') || pm.collectionVariables.get('student_id') || '22127001';",
          "pm.request.headers.upsert({",
          "    key: 'X-Student-Id',",
          "    value: studentId",
          "});",
          "",
          "// Đọc dữ liệu từ file Data-Driven (iterationData)",
          "const tcId = pm.iterationData.get('test_case_id') || 'TC_DEFAULT';",
          "const description = pm.iterationData.get('description') || 'Default Request';",
          "const queryString = pm.iterationData.get('query_string') || '';",
          "",
          "// Cập nhật biến động URL query string",
          "pm.variables.set('current_query', queryString);",
          "",
          "console.log(`[DATA-DRIVEN RUN] Iteration #${pm.info.iteration + 1} | [${tcId}] ${description}`);",
          "console.log(`[DATA-DRIVEN PRE-REQUEST] Injected Header 'X-Student-Id: ${studentId}' | URL: /api/products${queryString}`);"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const tcId = pm.iterationData.get('test_case_id') || 'TC_DEFAULT';",
          "const description = pm.iterationData.get('description') || '';",
          "const expectedStatus = pm.iterationData.get('expected_status') || 200;",
          "const expectedType = pm.iterationData.get('expected_type') || 'array';",
          "const expectEmpty = pm.iterationData.get('expect_empty') || false;",
          "const expectContains = pm.iterationData.get('expect_contains') || '';",
          "const sqlInjectionCheck = pm.iterationData.get('sql_injection_check') || false;",
          "",
          "// Assertion 1: HTTP Status Code",
          "pm.test(`[${tcId}] HTTP Status code is ${expectedStatus}`, function () {",
          "    pm.response.to.have.status(expectedStatus);",
          "});",
          "",
          "// Assertion 2: SLA Response Time",
          "pm.test(`[${tcId}] Response time is under 500ms`, function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(500);",
          "});",
          "",
          "// Assertion 3: Content-Type JSON",
          "pm.test(`[${tcId}] Content-Type is application/json`, function () {",
          "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "});",
          "",
          "// Assertion 4: Response Schema Validation",
          "if (expectedType === 'array') {",
          "    pm.test(`[${tcId}] Root response is a JSON Array`, function () {",
          "        const jsonData = pm.response.json();",
          "        pm.expect(jsonData).to.be.an('array');",
          "        ",
          "        if (expectEmpty) {",
          "            pm.expect(jsonData.length).to.eql(0);",
          "        }",
          "        ",
          "        if (expectContains && expectContains.trim() !== '') {",
          "            const found = jsonData.some(item => ",
          "                item.name && item.name.toLowerCase().includes(expectContains.toLowerCase())",
          "            );",
          "            pm.expect(found).to.be.true;",
          "        }",
          "    });",
          "}",
          "",
          "// Assertion 5: Security / SQL Injection Check (SEC-05)",
          "if (sqlInjectionCheck) {",
          "    pm.test(`[${tcId}] SEC-05: Safe SQL execution without leaking errors or credentials`, function () {",
          "        const responseText = pm.response.text();",
          "        pm.expect(responseText).to.not.include('Database Error');",
          "        pm.expect(responseText).to.not.include('admin@eshop.com');",
          "        pm.expect(responseText).to.not.include('Admin123!');",
          "    });",
          "}",
          "",
          "console.log(`[DATA-DRIVEN RESULT] [${tcId}] Completed with Status: ${pm.response.code} in ${pm.response.responseTime}ms`);"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "student_id",
      "value": "22127001",
      "type": "string"
    },
    {
      "key": "current_query",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Data-Driven Request: GET /api/products{{current_query}}",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products{{current_query}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products{{current_query}}"]
        }
      }
    }
  ]
}
