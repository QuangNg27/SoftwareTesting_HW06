{
	"info": {
		"_postman_id": "c18a45b7-7e89-4d2a-89a1-fr18poolc001",
		"name": "HW06_PoolC_FR18_DataDriven",
		"description": "Data-Driven Postman Collection for FR-18 (Admin Orders Management: PUT /api/admin/orders/:id/status & GET /api/admin/orders) with ISTQB compliance, RBAC security testing, and Anti-Cheat Header X-Student-Id: 23127462.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "00. Setup - Authenticate Admin (POST /api/login)",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"pm.request.headers.add({ key: 'X-Student-Id', value: '23127462' });"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"[Setup] Admin Login successful (200 OK)\", function () {",
							"    pm.response.to.have.status(200);",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('token');",
							"    pm.environment.set(\"adminToken\", jsonData.token);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"admin@eshop.com\",\n    \"password\": \"Admin123!\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/login",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"login"
					]
				}
			},
			"response": []
		},
		{
			"name": "01. Setup - Authenticate User (POST /api/login)",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"pm.request.headers.add({ key: 'X-Student-Id', value: '23127462' });"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"[Setup] User Login successful (200 OK)\", function () {",
							"    pm.response.to.have.status(200);",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('token');",
							"    pm.environment.set(\"userToken\", jsonData.token);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"test@eshop.com\",\n    \"password\": \"Test1234!\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/login",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"login"
					]
				}
			},
			"response": []
		},
		{
			"name": "02. Execute FR-18 Order Status & List Data-Driven Tests",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const tcId = pm.iterationData.get('test_case_id');",
							"const category = pm.iterationData.get('category');",
							"const subType = pm.iterationData.get('sub_type') || '';",
							"const orderId = pm.iterationData.get('order_id');",
							"const authType = pm.iterationData.get('auth_type');",
							"const requestBody = pm.iterationData.get('request_body');",
							"",
							"// 1. Set Anti-Cheat Student ID Header",
							"pm.request.headers.add({ key: 'X-Student-Id', value: '23127462' });",
							"",
							"// 2. Configure Dynamic Authentication Header",
							"pm.request.headers.remove('Authorization');",
							"if (authType === 'ADMIN') {",
							"    const adminToken = pm.environment.get('adminToken');",
							"    if (adminToken) pm.request.headers.add({ key: 'Authorization', value: 'Bearer ' + adminToken });",
							"} else if (authType === 'USER') {",
							"    const userToken = pm.environment.get('userToken');",
							"    if (userToken) pm.request.headers.add({ key: 'Authorization', value: 'Bearer ' + userToken });",
							"} else if (authType === 'EMPTY') {",
							"    pm.request.headers.add({ key: 'Authorization', value: 'Bearer ' });",
							"} else if (authType === 'INVALID') {",
							"    pm.request.headers.add({ key: 'Authorization', value: 'Bearer invalid.jwt.token' });",
							"} else if (authType === 'BASIC') {",
							"    pm.request.headers.add({ key: 'Authorization', value: 'Basic YWRtaW46MTIz' });",
							"}",
							"",
							"// 3. Configure Method, Path & Content-Type",
							"if (subType.includes('GET')) {",
							"    pm.request.method = 'GET';",
							"    pm.request.url.raw = pm.environment.get('baseUrl') + '/api/admin/orders';",
							"    pm.request.url.path = ['api', 'admin', 'orders'];",
							"    pm.request.body = undefined;",
							"} else {",
							"    pm.request.method = 'PUT';",
							"    pm.request.url.raw = pm.environment.get('baseUrl') + '/api/admin/orders/' + orderId + '/status';",
							"    pm.request.url.path = ['api', 'admin', 'orders', orderId, 'status'];",
							"    ",
							"    if (subType.includes('text/plain')) {",
							"        pm.request.headers.remove('Content-Type');",
							"        pm.request.headers.add({ key: 'Content-Type', value: 'text/plain' });",
							"        pm.request.body.update({ mode: 'raw', raw: requestBody });",
							"    } else {",
							"        pm.request.headers.remove('Content-Type');",
							"        pm.request.headers.add({ key: 'Content-Type', value: 'application/json' });",
							"        pm.request.body.update({ mode: 'raw', raw: requestBody });",
							"    }",
							"}"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"const tcId = pm.iterationData.get('test_case_id');",
							"const category = pm.iterationData.get('category');",
							"const subType = pm.iterationData.get('sub_type') || '';",
							"const expectedStatus = parseInt(pm.iterationData.get('expected_status'), 10);",
							"const expectedResult = pm.iterationData.get('expected_result');",
							"",
							"// Test 1: Verify HTTP Status Code Match",
							"pm.test(`[${tcId}] Status Code match expected ${expectedStatus}`, function () {",
							"    pm.expect(pm.response.code).to.eql(expectedStatus);",
							"});",
							"",
							"// Test 2: Response Time SLA (< 2000ms)",
							"pm.test(`[${tcId}] Response time is within acceptable limit (< 2000ms)`, function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(2000);",
							"});",
							"",
							"// Test 3: Content-Type & JSON Contract Validation",
							"if (pm.response.code === 200) {",
							"    pm.test(`[${tcId}] Content-Type is application/json`, function () {",
							"        pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
							"    });",
							"    ",
							"    if (subType.includes('GET')) {",
							"        pm.test(`[${tcId}] Root JSON is Array and items have required schema properties`, function () {",
							"            const jsonData = pm.response.json();",
							"            pm.expect(jsonData).to.be.an('array');",
							"            if (jsonData.length > 0) {",
							"                const order = jsonData[0];",
							"                pm.expect(order).to.have.property('id');",
							"                pm.expect(order).to.have.property('status');",
							"                pm.expect(order).to.have.property('total_amount');",
							"            }",
							"        });",
							"    } else {",
							"        pm.test(`[${tcId}] PUT Success schema matches message contract`, function () {",
							"            const jsonData = pm.response.json();",
							"            pm.expect(jsonData).to.have.property('message');",
							"        });",
							"    }",
							"} else if (pm.response.code >= 400 && pm.response.code < 500) {",
							"    pm.test(`[${tcId}] Error response is JSON with error message`, function () {",
							"        if (pm.response.headers.get('Content-Type') && pm.response.headers.get('Content-Type').includes('application/json')) {",
							"            const jsonData = pm.response.json();",
							"            pm.expect(jsonData).to.have.property('error');",
							"        }",
							"    });",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"status\": \"confirmed\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/admin/orders/1/status",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"admin",
						"orders",
						"1",
						"status"
					]
				}
			},
			"response": []
		}
	]
}
